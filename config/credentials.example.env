# Copia este archivo a private/credentials.env (private/ está en .gitignore) y llena los valores.
# Ver docs/credenciales.md para obtenerlos. NO pongas tus credenciales en este archivo de ejemplo.
#
#   cp config/credentials.example.env private/credentials.env && chmod 600 private/credentials.env
#
# Borra private/credentials.env cuando termine la descarga (o usa `uv run gbm download --delete-credentials`).

# JWT del encabezado Authorization, sin la palabra "Bearer". Si lo dejas vacío, `gbm download` lo pide sin mostrarlo.
GBM_TOKEN=

# GBM_ACCOUNT_ID:  tu cuenta completa de GBM. UUID de la RUTA de la petición  .../v1/dashboard/contracts/<GBM_ACCOUNT_ID>/accounts
# GBM_CONTRACT_ID: tu contrato de trading. Campo account_id, en la RESPUESTA de esa petición, del contrato con tu "name"
# Sí: GBM nombra estos dos al revés en su API (ver "Cuenta vs. contrato" en docs/credenciales.md). Cópialos tal cual.
GBM_ACCOUNT_ID=
GBM_CONTRACT_ID=
